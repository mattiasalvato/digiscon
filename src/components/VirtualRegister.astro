---
---

<section class="relative py-20 sm:py-28 bg-zinc-50 border-y border-zinc-200/80 overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-zinc-900 tracking-tight leading-[1.1]">
        Il tuo registratore di <br />
        cassa virtuale <span class="text-[#FF6B00]">è Digiscon!</span>
      </h2>

      <p class="mt-6 text-base sm:text-lg text-zinc-600 leading-relaxed max-w-xl mx-auto font-normal">
        <strong class="text-zinc-900 font-bold">Risparmia</strong> sui costi di gestione del registratore di cassa con una semplice app. <br />
        <span class="text-[#FF6B00] font-bold block sm:inline mt-1">È facile, è veloce, è economica.</span>
      </p>

      <div class="mt-8">
        <a 
          href="#prezzi" 
          class="inline-flex items-center justify-center px-8 py-3.5 text-sm sm:text-base font-bold text-white bg-[#FF6B00] hover:bg-[#E55F00] active:scale-95 rounded-full transition-colors"
        >
          Provalo Gratis
        </a>
      </div>
    </div>

    <div class="relative mt-14 sm:mt-18 max-w-4xl mx-auto flex items-end justify-center">

      <div class="relative w-full max-w-[540px] bg-zinc-950 rounded-[2.5rem] p-3.5 border-4 border-zinc-800 -mr-16 sm:-mr-20 z-10 shadow-lg">
        <div class="bg-white rounded-[2rem] overflow-hidden p-5 border border-zinc-100 flex flex-col justify-between h-[340px]">
          
          <div class="flex items-center justify-between pb-3 border-b border-zinc-100 text-xs text-zinc-500 font-semibold">
            <div class="flex items-center gap-3">
              <span class="font-black text-[#FF6B00] text-sm">Digiscon Pos</span>
              <span class="bg-orange-50 text-[#FF6B00] px-2 py-0.5 rounded-lg text-[10px] font-bold">★ Preferiti</span>
              <span class="text-[10px] text-zinc-400">Categorie</span>
            </div>
            <span class="text-[11px] text-emerald-600 font-bold">● Cassa Connessa AdE</span>
          </div>

          <div class="grid grid-cols-3 gap-2 my-auto py-2">
            <div class="bg-zinc-50 p-2.5 rounded-xl border border-zinc-200">
              <p class="text-[10px] text-zinc-500">Taglio & Piega</p>
              <p class="text-xs font-black text-zinc-800 mt-1">€ 35,00</p>
            </div>
            <div class="bg-zinc-50 p-2.5 rounded-xl border border-zinc-200">
              <p class="text-[10px] text-zinc-500">Colore Completo</p>
              <p class="text-xs font-black text-zinc-800 mt-1">€ 42,00</p>
            </div>
            <div class="bg-zinc-50 p-2.5 rounded-xl border border-zinc-200">
              <p class="text-[10px] text-zinc-500">Trattamento</p>
              <p class="text-xs font-black text-zinc-800 mt-1">€ 18,00</p>
            </div>
          </div>

          <div class="pt-3 border-t border-zinc-100 flex items-center justify-between">
            <div>
              <span class="text-[10px] text-zinc-400 uppercase font-bold">Totale Corrispettivo</span>
              <div class="text-xl font-black text-zinc-900">€ 95,00</div>
            </div>
            <button class="px-6 py-2.5 bg-[#FF6B00] hover:bg-[#E55F00] text-white font-bold text-xs rounded-xl transition-colors">
              Paga ed Emetti
            </button>
          </div>

        </div>
      </div>

      <div class="relative w-48 sm:w-56 shrink-0 z-20 -mb-4">
        <div class="bg-zinc-950 rounded-[2.2rem] p-2.5 border-2 border-zinc-800 shadow-xl">
          <div class="bg-white rounded-[1.8rem] overflow-hidden p-3 h-[300px] flex flex-col justify-between border border-zinc-100">
            <div class="flex justify-between items-center text-[10px] font-bold text-zinc-500 pb-1 border-b">
              <span>Digiscon Mobile</span>
              <span class="text-[#FF6B00]">€ 56,00</span>
            </div>
            <div class="text-center my-auto p-2 bg-zinc-50 rounded-xl">
              <p class="text-[10px] text-zinc-400">Ultimo Invio</p>
              <p class="text-xs font-bold text-zinc-800">Doc. #0192</p>
            </div>
            <div class="w-full py-2 bg-[#FF6B00] text-white text-[10px] font-bold text-center rounded-lg">
              Invio Eseguito
            </div>
          </div>
        </div>

        <div class="absolute -bottom-8 -right-4 sm:-right-8 w-44 sm:w-52 bg-white rounded-2xl border border-zinc-200 p-3 transform rotate-6 z-30 shadow-md">
          <div class="border-b border-dashed border-zinc-300 pb-2 text-center">
            <p class="text-[10px] font-mono font-bold text-zinc-800 uppercase tracking-widest">Documento Commerciale</p>
            <p class="text-[8px] font-mono text-zinc-400">Agenzia delle Entrate</p>
          </div>
          <div class="py-2 space-y-1 font-mono text-[9px] text-zinc-600">
            <div class="flex justify-between">
              <span>Prestazione</span>
              <span class="font-bold">€ 45,00</span>
            </div>
            <div class="flex justify-between">
              <span>IVA 22%</span>
              <span>€ 9,90</span>
            </div>
            <div class="flex justify-between text-zinc-900 font-black border-t border-zinc-200 pt-1 mt-1">
              <span>TOTALE</span>
              <span>€ 54,90</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>