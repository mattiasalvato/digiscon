---
// Slider Attività con illustrazioni vettoriali uniche per ogni tipologia di business
const activities = [
  {
    id: "ambulanti",
    title: "Ambulanti e Fiere",
    desc: "Nessun cavo o batteria ingombrante sul banco. Emetti corrispettivi direttamente dal telefono sotto il gazebo o tra i banchi del mercato.",
    highlight: "Scontrini via WhatsApp o stampantina tascabile Bluetooth",
  },
  {
    id: "beauty",
    title: "Parrucchieri ed Estetica",
    desc: "Invia lo scontrino digitale sul telefono della cliente mentre effettua il pagamento. Zero rotoli di carta sprecati alla reception.",
    highlight: "Condivisione immediata via SMS, Email o WhatsApp",
  },
  {
    id: "artigiani",
    title: "Artigiani e Tecnici",
    desc: "Idraulici, elettricisti e installatori. Incassa sul posto dal cliente ed emetti il documento fiscale valido prima ancora di risalire sul furgone.",
    highlight: "Compatibile con POS portatili come SumUp e Nexi",
  },
  {
    id: "retail",
    title: "Commercio al Dettaglio",
    desc: "Una postazione cassa ultra-moderna su tablet. E se il negozio cresce, si collega istantaneamente al gestionale magazzino Negozio Easy.",
    highlight: "Compatibile con lettori barcode e l'ecosistema Negozio Easy",
  },
  {
    id: "professionisti",
    title: "Liberi Professionisti",
    desc: "Ideale per regimi forfettari e attività che devono rilasciare scontrini regolari senza dover acquistare un registratore da centinaia di euro.",
    highlight: "Nessuna verifica periodica obbligatoria di legge",
  }
];
---

<section id="attivita" class="relative py-20 sm:py-28 bg-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Header Sezione -->
    <div class="mb-10 sm:mb-14">
      <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-blue-50 border border-blue-200/60 text-blue-700 text-xs font-semibold mb-3">
        Settori di Utilizzo
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Fatto su misura per il tuo lavoro.
      </h2>
    </div>

    <!-- CAROUSEL WRAPPER -->
    <div class="relative">
      
      <!-- Contenitore Snap a Scorrimento -->
      <div 
        id="activities-slider" 
        class="flex gap-8 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-6 pt-2 no-scrollbar items-stretch"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {activities.map((act) => (
          <div class="snap-start shrink-0 w-[88vw] sm:w-[75vw] lg:w-[860px] bg-slate-50/70 border border-slate-200/60 rounded-[2.5rem] p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-8 select-none">
            
            <!-- Colonna Testo (Sinistra) -->
            <div class="md:w-1/2 flex flex-col justify-between h-full">
              <div>
                <h3 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
                  {act.title}
                </h3>
                <p class="text-base sm:text-lg text-slate-600 mt-4 leading-relaxed font-normal">
                  {act.desc}
                </p>
              </div>

              <div class="mt-8 pt-4 border-t border-slate-200/60">
                <p class="text-xs sm:text-sm font-semibold text-slate-500">
                  {act.highlight}
                </p>
              </div>
            </div>

            <!-- Colonna Grafica Illustrata (Destra) -->
            <div class="md:w-1/2 w-full flex items-center justify-center p-2">
              <div class="relative w-full max-w-[340px] aspect-[4/3] flex items-center justify-center">

                {/* 1. Ambulanti e Fiere: Tende mercato, mongolfiera, attrazioni */}
                {act.id === "ambulanti" && (
                  <svg viewBox="0 0 400 300" class="w-full h-auto drop-shadow-sm" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M120 70c0-16 13-30 30-30 6 0 12 2 17 6 5-18 21-31 40-31 23 0 42 19 42 42 7 1 13 5 17 10 4 5 6 11 6 17 0 14-11 25-25 25H145c-14 0-25-11-25-25z" fill="#38BDF8" opacity="0.3"/>
                    <path d="M260 100c0-12 10-22 22-22 5 0 9 2 12 5 4-13 15-23 29-23 17 0 31 14 31 31 5 1 9 4 12 8 3 4 5 8 5 13 0 10-8 19-19 19H282c-10 0-19-8-19-19z" fill="#0284C7" opacity="0.4"/>
                    <path d="M280 120c30 0 55-25 55-55s-25-55-55-55-55 25-55 55 25 55 55 55z" fill="#FDA4AF"/>
                    <path d="M280 10c18 0 32 25 32 55s-14 55-32 55-32-25-32-55 14-55 32-55z" fill="#F43F5E" opacity="0.4"/>
                    <rect x="274" y="130" width="12" height="10" rx="2" fill="#D97706"/>
                    <path d="M140 260l35-110 35 110H140z" fill="#F59E0B"/>
                    <path d="M158 260l17-110 17 110H158z" fill="#FBBF24"/>
                    <path d="M175 130v20" stroke="#F59E0B" stroke-width="4"/>
                    <path d="M175 130l20 8-20 8v-16z" fill="#F59E0B"/>
                    <path d="M210 260l50-130 50 130H210z" fill="#EF4444"/>
                    <path d="M230 260l30-130 10 130H230z" fill="#FFFFFF"/>
                    <path d="M250 260l10-130 15 130H250z" fill="#F87171"/>
                    <path d="M260 110v20" stroke="#EF4444" stroke-width="4"/>
                    <path d="M260 110l22 9-22 9v-18z" fill="#EF4444"/>
                    <path d="M300 260c10-50 40-90 70-70s30 70 30 70" stroke="#10B981" stroke-width="12" stroke-linecap="round"/>
                    <rect x="330" y="210" width="50" height="50" rx="8" fill="#67E8F9" opacity="0.8"/>
                    <path d="M330 225c10 8 30 8 40 0" stroke="#0284C7" stroke-width="4"/>
                  </svg>
                )}

                {/* 2. Parrucchieri ed Estetica: Specchio vanity, forbici, flacone, poltrona */}
                {act.id === "beauty" && (
                  <svg viewBox="0 0 400 300" class="w-full h-auto drop-shadow-sm" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Specchio ovale vanity illuminato -->
                    <ellipse cx="200" cy="130" rx="75" ry="95" fill="#FCE7F3" stroke="#F472B6" stroke-width="8"/>
                    <ellipse cx="200" cy="130" rx="60" ry="80" fill="#FFFFFF"/>
                    <path d="M175 90c-15 18-20 45-10 65" stroke="#FBCFE8" stroke-width="6" stroke-linecap="round"/>
                    
                    <!-- Base specchio da toeletta -->
                    <rect x="188" y="225" width="24" height="25" fill="#F472B6" rx="4"/>
                    <rect x="150" y="250" width="100" height="12" rx="6" fill="#EC4899"/>
                    
                    <!-- Flacone spray cosmetico (sinistra) -->
                    <rect x="95" y="170" width="40" height="85" rx="10" fill="#A78BFA"/>
                    <rect x="105" y="150" width="20" height="20" rx="4" fill="#C4B5FD"/>
                    <path d="M102 150h-12v-8h28v8h-16z" fill="#8B5CF6"/>
                    <path d="M85 146l-8-5" stroke="#8B5CF6" stroke-width="3" stroke-linecap="round"/>
                    
                    <!-- Forbici stilizzate (destra) -->
                    <circle cx="280" cy="225" r="14" stroke="#FB7185" stroke-width="5"/>
                    <circle cx="310" cy="235" r="14" stroke="#FB7185" stroke-width="5"/>
                    <path d="M285 215l35-70" stroke="#FB7185" stroke-width="6" stroke-linecap="round"/>
                    <path d="M305 225l-45-65" stroke="#FDA4AF" stroke-width="6" stroke-linecap="round"/>
                    
                    <!-- Lustrini / stelle beauty -->
                    <path d="M315 80l4 8 8 4-8 4-4 8-4-8-8-4 8-4z" fill="#FBBF24"/>
                    <path d="M90 100l3 6 6 3-6 3-3 6-3-6-6-3 6-3z" fill="#F472B6"/>
                  </svg>
                )}

                {/* 3. Artigiani e Tecnici: Cassetta attrezzi, chiave inglese, martello, ingranaggi */}
                {act.id === "artigiani" && (
                  <svg viewBox="0 0 400 300" class="w-full h-auto drop-shadow-sm" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Ingranaggi di sfondo -->
                    <circle cx="110" cy="95" r="28" fill="#93C5FD" opacity="0.4"/>
                    <circle cx="290" cy="80" r="36" fill="#60A5FA" opacity="0.3"/>
                    
                    <!-- Cassetta attrezzi -->
                    <rect x="120" y="155" width="160" height="95" rx="14" fill="#2563EB"/>
                    <rect x="110" y="140" width="180" height="20" rx="6" fill="#1D4ED8"/>
                    
                    <!-- Maniglia cassetta -->
                    <path d="M165 140v-30h70v30" stroke="#93C5FD" stroke-width="8" stroke-linecap="round"/>
                    <!-- Chiusura metallica -->
                    <rect x="185" y="155" width="30" height="24" rx="4" fill="#FDE047"/>
                    
                    <!-- Martello che sporge a sinistra -->
                    <path d="M130 145l-45-60" stroke="#D97706" stroke-width="10" stroke-linecap="round"/>
                    <rect x="75" y="70" width="35" height="22" rx="4" fill="#64748B" transform="rotate(-35 75 70)"/>
                    
                    <!-- Chiave inglese che sporge a destra -->
                    <path d="M260 145l45-55" stroke="#94A3B8" stroke-width="12" stroke-linecap="round"/>
                    <circle cx="310" cy="85" r="16" stroke="#64748B" stroke-width="8"/>
                    <path d="M305 85h15" stroke="#FFFFFF" stroke-width="6"/>

                    <!-- Tacche e righello base -->
                    <rect x="140" y="210" width="120" height="10" rx="3" fill="#1E40AF"/>
                  </svg>
                )}

                {/* 4. Commercio al Dettaglio: Vetrina negozio, tenda parasole a righe, sacchetto shopper */}
                {act.id === "retail" && (
                  <svg viewBox="0 0 400 300" class="w-full h-auto drop-shadow-sm" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Struttura Vetrina -->
                    <rect x="110" y="110" width="180" height="145" rx="12" fill="#ECFDF5" stroke="#10B981" stroke-width="6"/>
                    <rect x="135" y="145" width="60" height="110" rx="6" fill="#A7F3D0" opacity="0.5"/>
                    <rect x="205" y="145" width="60" height="110" rx="6" fill="#A7F3D0" opacity="0.5"/>
                    
                    <!-- Tenda parasole a strisce verdi e bianche -->
                    <path d="M95 110h210l-15-40H110l-15 40z" fill="#059669"/>
                    <path d="M125 110h30l-5-40h-25l0 40z" fill="#FFFFFF"/>
                    <path d="M185 110h30l-5-40h-25l0 40z" fill="#FFFFFF"/>
                    <path d="M245 110h30l-5-40h-25l0 40z" fill="#FFFFFF"/>
                    
                    <!-- Falde ondulate tenda -->
                    <path d="M95 110c0 8 7 14 15 14s15-6 15-14c0 8 7 14 15 14s15-6 15-14c0 8 7 14 15 14s15-6 15-14c0 8 7 14 15 14s15-6 15-14c0 8 7 14 15 14s15-6 15-14c0 8 7 14 15 14s15-6 15-14" fill="#047857"/>

                    <!-- Shopper bag in primo piano (destra) -->
                    <rect x="260" y="180" width="55" height="70" rx="8" fill="#F59E0B"/>
                    <path d="M275 180v-16c0-6 5-12 12-12s12 6 12 12v16" stroke="#D97706" stroke-width="5" stroke-linecap="round"/>
                    <circle cx="287" cy="215" r="8" fill="#FDE68A"/>

                    <!-- Cartello OPEN appeso -->
                    <rect x="150" y="165" width="30" height="18" rx="4" fill="#EF4444"/>
                    <path d="M157 165l8-10 8 10" stroke="#64748B" stroke-width="2"/>
                  </svg>
                )}

                {/* 5. Liberi Professionisti: Laptop, tazza di caffè, pianta da scrivania, foglio contratto */}
                {act.id === "professionisti" && (
                  <svg viewBox="0 0 400 300" class="w-full h-auto drop-shadow-sm" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- Monitor / Laptop -->
                    <rect x="135" y="90" width="130" height="85" rx="8" fill="#334155"/>
                    <rect x="142" y="97" width="116" height="71" rx="4" fill="#F8FAFC"/>
                    <!-- Finestra codice/grafico su schermo -->
                    <rect x="150" y="107" width="40" height="6" rx="2" fill="#6366F1"/>
                    <rect x="150" y="120" width="60" height="4" rx="2" fill="#94A3B8"/>
                    <rect x="150" y="130" width="50" height="4" rx="2" fill="#CBD5E1"/>
                    <circle cx="230" cy="130" r="14" fill="#EEF2FF"/>
                    <path d="M230 120v10h10" stroke="#4F46E5" stroke-width="3"/>

                    <!-- Base / Tastiera laptop -->
                    <path d="M110 175h180l-12 15H122l-12-15z" fill="#64748B"/>
                    <rect x="175" y="177" width="50" height="6" rx="2" fill="#94A3B8"/>

                    <!-- Tazza caffè (destra) -->
                    <rect x="290" y="165" width="28" height="32" rx="6" fill="#F97316"/>
                    <path d="M318 172c5 0 8 3 8 7s-3 7-8 7" stroke="#EA580C" stroke-width="4"/>
                    <path d="M296 155c0-5 5-8 5-13" stroke="#FDBA74" stroke-width="2" stroke-linecap="round"/>

                    <!-- Piantina minimal da scrivania (sinistra) -->
                    <path d="M85 195l6-25h20l6 25H85z" fill="#CBD5E1"/>
                    <ellipse cx="98" cy="160" rx="10" ry="18" fill="#10B981" transform="rotate(-15 98 160)"/>
                    <ellipse cx="104" cy="155" rx="9" ry="16" fill="#34D399" transform="rotate(20 104 155)"/>

                    <!-- Piano scrivania -->
                    <rect x="60" y="195" width="280" height="10" rx="5" fill="#E2E8F0"/>
                  </svg>
                )}

              </div>
            </div>

          </div>
        ))}
      </div>

      <!-- FRECCE DI CONTROLLO BOTTOM (Sinistra e Destra separate agli estremi) -->
      <div class="flex items-center justify-between mt-8 px-2 sm:px-4">
        <button 
          id="slide-prev"
          aria-label="Attività precedente"
          class="p-2 text-slate-900 hover:text-blue-600 active:scale-90 transition-all cursor-pointer"
        >
          <svg class="w-10 h-10 sm:w-12 sm:h-12 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0l7 7m-7-7l7-7" />
          </svg>
        </button>

        <button 
          id="slide-next"
          aria-label="Attività successiva"
          class="p-2 text-slate-900 hover:text-blue-600 active:scale-90 transition-all cursor-pointer"
        >
          <svg class="w-10 h-10 sm:w-12 sm:h-12 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-7-7m7 7l-7 7" />
          </svg>
        </button>
      </div>

    </div>

  </div>
</section>

<script>
  const slider = document.getElementById('activities-slider');
  const prevBtn = document.getElementById('slide-prev');
  const nextBtn = document.getElementById('slide-next');

  if (slider && prevBtn && nextBtn) {
    const getScrollAmount = () => {
      return slider.firstElementChild ? (slider.firstElementChild as HTMLElement).offsetWidth + 32 : 400;
    };

    nextBtn.addEventListener('click', () => {
      slider.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
    });

    prevBtn.addEventListener('click', () => {
      slider.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    });
  }
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
