---

<header class="fixed top-6 left-0 right-0 z-50 flex justify-center px-4">
  <nav class="flex items-center justify-between w-full max-w-6xl bg-white/90 backdrop-blur-md border border-zinc-200/80 shadow-lg shadow-zinc-950/5 rounded-full px-6 py-3 transition-all duration-300">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <img src="/images/logo-digiscon.png" alt="Digiscon" class="h-8 w-auto transition-transform group-hover:scale-105" />
    </a>

    <!-- Menu Links (Desktop) -->
    <div class="hidden md:flex items-center gap-8 text-sm font-semibold text-zinc-700">
      <a href="#come-funziona" class="hover:text-[#FF6B00] transition-colors">Come Funziona</a>
      <a href="#funzionalita" class="hover:text-[#FF6B00] transition-colors">Funzionalità</a>
      <a href="#attivita" class="hover:text-[#FF6B00] transition-colors">Attività</a>
      <a href="#confronto" class="hover:text-[#FF6B00] transition-colors">Perché Digiscon</a>
      <a href="#prezzi" class="hover:text-[#FF6B00] transition-colors">Prezzi</a>
      <a href="#faq" class="hover:text-[#FF6B00] transition-colors">FAQ</a>
    </div>

    <!-- CTA Button -->
    <div class="flex items-center gap-3">
      <a 
        href="#prezzi" 
        class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold text-white bg-[#FF6B00] hover:bg-[#E55F00] active:scale-95 rounded-full shadow-md shadow-orange-500/20 transition-all duration-200"
      >
        Provalo Gratis
      </a>
    </div>
  </nav>
</header>
