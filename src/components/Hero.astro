---
---

<section class="relative min-h-screen pt-36 pb-20 flex flex-col justify-between overflow-hidden bg-gradient-to-b from-orange-50/40 via-zinc-50 to-white">
  
  <!-- Watermark Tipografico Sfondo -->
  <div class="absolute inset-0 flex items-center justify-between pointer-events-none select-none z-0 overflow-hidden">
    <span class="text-[14vw] font-black text-zinc-950/[0.03] tracking-tighter -ml-8 uppercase">
      Scopri
    </span>
    <span class="text-[14vw] font-black text-zinc-950/[0.03] tracking-tighter -mr-8 uppercase">
      Digiscon
    </span>
  </div>

  <!-- Contenuto Testuale Top -->
  <div class="relative z-10 max-w-5xl mx-auto px-4 text-center mt-4 sm:mt-8">
    <h1 class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-zinc-900 tracking-tight leading-[1.05]">
      Lo scontrino telematico
      <span class="block text-transparent bg-clip-text bg-gradient-to-r from-[#FF6B00] to-amber-500">
        nel tuo smartphone.
      </span>
    </h1>

    <p class="mt-6 text-lg sm:text-xl md:text-2xl text-zinc-600 max-w-3xl mx-auto font-normal leading-relaxed">
      Emetti scontrini fiscali e inviali direttamente all'Agenzia delle Entrate. 
      Nessun registratore di cassa fisico, nessuna verifica periodica.
    </p>
  </div>

  <!-- Mockup Showcase: 3 Telefoni con dettagli Arancione e Dark -->
  <div class="relative z-10 w-full max-w-6xl mx-auto px-4 mt-8 flex items-end justify-center">
    
    <!-- Telefono Sinistro: Desktop -->
    <div class="hidden lg:block w-64 -mr-12 mb-10 transform -rotate-6 hover:-rotate-2 transition-all duration-300 hover:z-20 filter drop-shadow-2xl">
      <div class="bg-zinc-900 rounded-[2.5rem] p-3 ring-1 ring-zinc-800 shadow-2xl">
        <div class="bg-white rounded-[2rem] overflow-hidden p-4 border border-zinc-100 flex flex-col justify-between h-[420px] text-xs">
          <div class="flex justify-between items-center text-zinc-400 font-semibold border-b pb-2">
            <span>Incasso rapido</span>
            <span class="text-[10px] bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full font-bold">Online AdE</span>
          </div>
          <div class="text-center my-auto">
            <span class="text-zinc-400 text-[11px] uppercase tracking-wider block">Totale Corrispettivo</span>
            <span class="text-3xl font-black text-zinc-900 tracking-tight">€ 100,00</span>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div class="bg-[#FF6B00] text-white p-2.5 rounded-xl font-bold text-center shadow-sm">Contanti</div>
            <div class="bg-orange-50 text-[#FF6B00] p-2.5 rounded-xl font-bold text-center border border-orange-200">POS / Carta</div>
            <div class="bg-zinc-50 text-zinc-700 p-2.5 rounded-xl font-bold text-center border">WhatsApp</div>
            <div class="bg-zinc-50 text-zinc-700 p-2.5 rounded-xl font-bold text-center border">Email / PDF</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Telefono Centrale -->
    <div class="relative z-10 w-72 sm:w-80 md:w-88 transform transition-transform duration-300 hover:scale-[1.02]">
      <div class="bg-zinc-950 rounded-[3rem] p-3.5 ring-4 ring-zinc-900/10 shadow-[0_35px_60px_-15px_rgba(15,23,42,0.3)]">
        <div class="bg-white rounded-[2.3rem] overflow-hidden flex flex-col h-[520px] border border-zinc-100">
          <div class="pt-3 pb-2 flex justify-center bg-white">
            <div class="w-24 h-4 bg-zinc-900 rounded-full"></div>
          </div>

          <div class="p-4 flex-1 flex flex-col justify-between">
            <div class="flex items-center justify-between text-xs font-semibold text-zinc-500 pb-2 border-b">
              <span class="text-[#FF6B00] font-bold text-sm">Digiscon App</span>
              <span class="text-emerald-600 font-semibold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Connesso AdE
              </span>
            </div>

            <div class="bg-zinc-50 rounded-2xl p-4 text-right my-2 border border-zinc-150">
              <span class="text-[11px] text-zinc-400 block font-medium">Nuovo Scontrino</span>
              <div class="text-3xl font-extrabold text-zinc-900 tracking-tight">€ 45,50</div>
            </div>

            <!-- Tastierino -->
            <div class="grid grid-cols-4 gap-1.5 text-center font-bold text-sm text-zinc-700">
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">7</div>
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">8</div>
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">9</div>
              <div class="bg-orange-50 text-[#FF6B00] p-3 rounded-xl font-semibold text-xs flex items-center justify-center">IVA 22%</div>
              
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">4</div>
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">5</div>
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">6</div>
              <div class="bg-orange-50 text-[#FF6B00] p-3 rounded-xl font-semibold text-xs flex items-center justify-center">IVA 10%</div>

              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">1</div>
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">2</div>
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">3</div>
              <div class="bg-orange-50 text-[#FF6B00] p-3 rounded-xl font-semibold text-xs flex items-center justify-center">IVA 4%</div>

              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">C</div>
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">0</div>
              <div class="bg-zinc-100 p-3 rounded-xl hover:bg-zinc-200 cursor-pointer">,</div>
              <div class="bg-[#FF6B00] text-white p-3 rounded-xl font-bold flex items-center justify-center shadow-sm">INVIO</div>
            </div>

            <button class="w-full mt-2 py-3 bg-[#FF6B00] hover:bg-[#E55F00] text-white font-bold text-xs uppercase tracking-wider rounded-xl shadow-md transition-colors">
              Emetti Documento Commerciale
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Telefono Destro: Report & Statistiche -->
    <div class="hidden lg:block w-64 -ml-12 mb-10 transform rotate-6 hover:rotate-2 transition-all duration-300 hover:z-20 filter drop-shadow-2xl">
      <div class="bg-zinc-900 rounded-[2.5rem] p-3 ring-1 ring-zinc-800 shadow-2xl">
        <div class="bg-white rounded-[2rem] overflow-hidden p-4 border border-zinc-100 flex flex-col justify-between h-[420px] text-xs">
          <div class="flex justify-between items-center text-zinc-400 font-semibold border-b pb-2">
            <span>Statistiche Oggi</span>
            <span class="text-[#FF6B00] font-bold">18 Scontrini</span>
          </div>
          
          <div class="flex flex-col items-center justify-center py-4">
            <div class="w-24 h-24 rounded-full border-8 border-[#FF6B00] border-t-amber-400 border-r-orange-300 flex items-center justify-center">
              <span class="text-[11px] font-black text-zinc-800">€ 840</span>
            </div>
            <span class="text-[10px] text-zinc-400 mt-2">Incasso giornaliero</span>
          </div>

          <div class="space-y-2">
            <div class="flex justify-between items-center p-2 rounded-lg bg-zinc-50">
              <span class="font-medium text-zinc-700">Servizi / Prestazioni</span>
              <span class="font-bold text-zinc-900">€ 520,00</span>
            </div>
            <div class="flex justify-between items-center p-2 rounded-lg bg-zinc-50">
              <span class="font-medium text-zinc-700">Vendita Articoli</span>
              <span class="font-bold text-zinc-900">€ 320,00</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Bottom CTA -->
  <div class="relative z-10 text-center mt-6">
    <a 
      href="#prezzi" 
      class="inline-flex items-center gap-2 px-8 py-4 text-base font-bold text-white bg-[#FF6B00] hover:bg-[#E55F00] rounded-full shadow-lg shadow-orange-500/30 hover:scale-105 active:scale-95 transition-all duration-200"
    >
      Inizia la prova gratuita di 15 giorni
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
    <p class="text-xs text-zinc-500 mt-2 font-medium">Nessuna carta di credito richiesta • Configurazione in 2 minuti</p>
  </div>
</section>
