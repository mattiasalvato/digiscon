---
const features = [
  {
    title: "Emissione scontrini digitali in pochi secondi",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z" />`,
  },
  {
    title: "Gestione scontrini di reso e annullamento scontrini",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />`,
  },
  {
    title: "Integrazione con sistemi di pagamento come SumUp e Nexi",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />`,
  },
  {
    title: "Invio scontrino tramite email, Whatsapp, SMS, QR code",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />`,
  },
  {
    title: "Invio automatico dei corrispettivi all'Agenzia delle Entrate",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />`,
  },
  {
    title: "Consultazione storico documenti e report incassi",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`,
  },
  {
    title: "Integrazione con stampante termica Bluetooth",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />`,
  },
  {
    title: "Integrazione con WooCommerce, Shopify e Negozio Easy",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />`,
  },
];
---

<section id="funzionalita" class="relative py-24 sm:py-32 bg-white overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <div class="max-w-3xl mb-16 sm:mb-20">
      <h2 class="text-4xl sm:text-5xl md:text-6xl font-black text-zinc-900 tracking-tight leading-[1.1]">
        Cosa puoi fare <br />
        con <span class="text-[#FF6B00]">Digiscon</span>
      </h2>
      <p class="text-base sm:text-lg text-zinc-600 mt-5 leading-relaxed font-normal max-w-xl">
        Scopri tutto ciò che puoi fare grazie a Digiscon con il solo utilizzo del tuo <strong class="text-zinc-900 font-bold">smartphone o tablet</strong> e senza il bisogno di un registratore di cassa tradizionale.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">

      <div class="lg:col-span-5 relative flex items-center justify-center min-h-[460px]">
        <div class="absolute -left-4 top-1/4 w-32 h-32 rounded-full bg-orange-100 -z-10"></div>
        <div class="absolute left-1/3 top-6 w-44 h-44 rounded-full bg-zinc-100 -z-10"></div>
        <div class="absolute right-4 bottom-10 w-28 h-28 rounded-full bg-orange-200/60 -z-10"></div>

        <div class="relative w-64 sm:w-72" style="perspective: 1200px;">
          <div 
            class="bg-zinc-950 rounded-[2.8rem] p-3 border-4 border-zinc-800 shadow-xl"
            style="transform: rotateY(-18deg) rotateX(12deg) rotateZ(-4deg);"
          >
            <div class="bg-white rounded-[2.2rem] overflow-hidden p-4 border border-zinc-100 flex flex-col justify-between h-[450px]">
              
              <div class="flex justify-between items-center pb-2 border-b border-zinc-100 text-[11px] font-bold text-zinc-500">
                <span class="text-[#FF6B00] font-black text-xs">Digiscon</span>
                <span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full text-[10px]">● AdE Live</span>
              </div>

              <div class="my-2 bg-zinc-50 p-3 rounded-2xl text-right border border-zinc-200">
                <span class="text-[10px] text-zinc-400 uppercase font-semibold">Totale Corrispettivo</span>
                <div class="text-2xl font-black text-zinc-900">€ 25,50</div>
              </div>

              <div class="grid grid-cols-2 gap-1.5 text-[10px] font-bold">
                <div class="bg-orange-50 text-[#FF6B00] p-2 rounded-xl text-center border border-orange-200/60">Reparto 1 (22%)</div>
                <div class="bg-zinc-100 text-zinc-700 p-2 rounded-xl text-center">Reparto 2 (10%)</div>
              </div>

              <div class="grid grid-cols-3 gap-1 text-center font-bold text-xs text-zinc-700 my-2">
                <div class="bg-zinc-100 p-2 rounded-lg">1</div>
                <div class="bg-zinc-100 p-2 rounded-lg">2</div>
                <div class="bg-zinc-100 p-2 rounded-lg">3</div>
                <div class="bg-zinc-100 p-2 rounded-lg">4</div>
                <div class="bg-zinc-100 p-2 rounded-lg">5</div>
                <div class="bg-zinc-100 p-2 rounded-lg">6</div>
                <div class="bg-zinc-100 p-2 rounded-lg">7</div>
                <div class="bg-zinc-100 p-2 rounded-lg">8</div>
                <div class="bg-zinc-100 p-2 rounded-lg">9</div>
                <div class="bg-zinc-100 p-2 rounded-lg">C</div>
                <div class="bg-zinc-100 p-2 rounded-lg">0</div>
                <div class="bg-zinc-100 p-2 rounded-lg">,</div>
              </div>

              <div class="py-2.5 bg-[#FF6B00] text-white font-bold text-center rounded-xl text-xs uppercase tracking-wider">
                Emetti Scontrino
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-10">
          {features.map((item) => (
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-zinc-950 text-[#FF6B00] border border-zinc-800 flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24" set:html={item.icon} />
              </div>

              <p class="text-sm sm:text-base font-bold text-zinc-800 leading-snug pt-1">
                {item.title}
              </p>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>