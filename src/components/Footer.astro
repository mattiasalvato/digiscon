---
interface Props {
  vatNumber?: string;
}

const { vatNumber = "03179480607" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="bg-zinc-950 text-zinc-400 pt-16 pb-12 border-t border-zinc-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <div class="grid grid-cols-2 md:grid-cols-12 gap-8 lg:gap-12 pb-12 border-b border-zinc-900">
      
      <!-- Colonna Brand (6 col) -->
      <div class="col-span-2 md:col-span-6 space-y-5">
        <a href="/" class="inline-block">
          <img 
            src="/images/logo-digiscon.png" 
            alt="Digiscon" 
            class="h-8 w-auto brightness-0 invert" 
          />
        </a>

        <p class="text-sm text-zinc-400 font-normal leading-relaxed max-w-md">
          La cassa telematica cloud su smartphone e tablet. Emetti corrispettivi e scontrini a norma di legge senza registratore fisico né verifiche periodiche.
        </p>

        <!-- Un prodotto di Dam Company -->
        <div class="pt-2 flex items-center gap-3">
          <span class="text-xs uppercase tracking-wider text-zinc-500 font-semibold">
            Un prodotto di
          </span>
          <a 
            href="https://www.damcompany.com" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center opacity-70 hover:opacity-100 transition-opacity"
            title="Dam Company"
          >
            <img 
              src="/images/logo-dam-company.png" 
              alt="Dam Company" 
              class="h-5 sm:h-6 w-auto brightness-0 invert object-contain" 
            />
          </a>
        </div>

        <p class="text-[11px] text-zinc-500 font-mono">
          Compatibile con cassetto fiscale Agenzia delle Entrate (DCO)
        </p>
      </div>

      <!-- Colonna Prodotto (3 col) -->
      <div class="col-span-1 md:col-span-3 space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-zinc-200">Prodotto</p>
        <ul class="space-y-2.5 text-sm font-medium">
          <li><a href="#come-funziona" class="hover:text-orange-400 transition-colors">Come Funziona</a></li>
          <li><a href="#funzionalita" class="hover:text-orange-400 transition-colors">Funzionalità</a></li>
          <li><a href="#attivita" class="hover:text-orange-400 transition-colors">Settori</a></li>
          <li><a href="#confronto" class="hover:text-orange-400 transition-colors">Perché Digiscon</a></li>
          <li><a href="#prezzi" class="hover:text-orange-400 transition-colors">Piani e Prezzi</a></li>
        </ul>
      </div>

      <!-- Colonna Supporto & Contatti (3 col) -->
      <div class="col-span-1 md:col-span-3 space-y-3">
        <p class="text-xs font-bold uppercase tracking-wider text-zinc-200">Supporto</p>
        <ul class="space-y-2.5 text-sm font-medium">
          <li><a href="#faq" class="hover:text-orange-400 transition-colors">Domande Frequenti</a></li>
          <li><a href="mailto:supporto@digiscon.it" class="hover:text-orange-400 transition-colors">supporto@digiscon.it</a></li>
          <li class="text-xs text-zinc-500 pt-2">
            Assistenza attiva dal Lunedì al Venerdì (9:00 - 18:00)
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar: Dati societari, P.IVA e Gestione Cookie -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-zinc-500 font-normal">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-x-5 gap-y-1 text-center md:text-left">
        <span>© {currentYear} Digiscon. Tutti i diritti riservati.</span>
        <span>Dam Company</span>
        <span class="font-mono text-zinc-400">P.IVA: {vatNumber}</span>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-5">
        <a href="/privacy" class="hover:text-zinc-300 transition-colors">Privacy Policy</a>
        <a href="/cookie" class="hover:text-zinc-300 transition-colors">Cookie Policy</a>
        <a href="/termini" class="hover:text-zinc-300 transition-colors">Termini di Servizio</a>
        
        <!-- Trigger Modifica Consenso Cookie -->
        <button 
          id="open-cookie-banner" 
          type="button" 
          class="text-zinc-400 hover:text-[#FF6B00] transition-colors underline underline-offset-4 cursor-pointer"
        >
          Preferenze Cookie
        </button>
      </div>
    </div>

  </div>
</footer>

<!-- BANNER ACCETTAZIONE / GESTIONE COOKIE -->
<div 
  id="cookie-banner" 
  class="fixed bottom-6 left-4 right-4 md:left-auto md:right-6 md:max-w-md z-50 bg-zinc-950 text-white p-6 rounded-3xl border border-zinc-800 shadow-2xl transition-all duration-300 transform translate-y-8 opacity-0 pointer-events-none"
  role="dialog"
  aria-live="polite"
  aria-label="Informativa sui cookie"
>
  <div class="flex items-start gap-3">
    <div class="p-2 rounded-xl bg-orange-500/10 text-[#FF6B00] shrink-0">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <div>
      <h3 class="text-sm font-bold text-zinc-100">Gestione Cookie & Privacy</h3>
      <p class="text-xs text-zinc-400 mt-1 leading-relaxed">
        Utilizziamo cookie tecnici essenziali per garantire il funzionamento del servizio e cookie anonimi per migliorare la tua esperienza. Puoi modificare le tue preferenze in qualsiasi momento.
      </p>
    </div>
  </div>

  <div class="mt-5 flex items-center justify-end gap-2.5">
    <button 
      id="cookie-reject" 
      type="button" 
      class="px-4 py-2 text-xs font-semibold text-zinc-300 hover:text-white bg-zinc-900 hover:bg-zinc-800 rounded-xl transition-colors cursor-pointer"
    >
      Solo Essenziali
    </button>
    <button 
      id="cookie-accept" 
      type="button" 
      class="px-4 py-2 text-xs font-bold text-white bg-[#FF6B00] hover:bg-[#E55F00] rounded-xl transition-colors cursor-pointer"
    >
      Accetta Tutti
    </button>
  </div>
</div>

<script>
  const banner = document.getElementById('cookie-banner');
  const btnAccept = document.getElementById('cookie-accept');
  const btnReject = document.getElementById('cookie-reject');
  const btnOpen = document.getElementById('open-cookie-banner');

  const showBanner = () => {
    banner?.classList.remove('translate-y-8', 'opacity-0', 'pointer-events-none');
    banner?.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
  };

  const hideBanner = () => {
    banner?.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
    banner?.classList.add('translate-y-8', 'opacity-0', 'pointer-events-none');
  };

  const savedConsent = localStorage.getItem('digiscon_cookie_consent');
  if (!savedConsent) {
    setTimeout(showBanner, 600);
  }

  btnAccept?.addEventListener('click', () => {
    localStorage.setItem('digiscon_cookie_consent', 'all');
    hideBanner();
  });

  btnReject?.addEventListener('click', () => {
    localStorage.setItem('digiscon_cookie_consent', 'essential');
    hideBanner();
  });

  btnOpen?.addEventListener('click', () => {
    showBanner();
  });
</script>